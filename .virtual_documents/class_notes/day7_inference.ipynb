




















from transformers import (
    pipeline,
    set_seed,
    pipeline
)
from datasets import load_dataset
import pandas as pd


# loading our dataset

ds = load_dataset("gofilipa/heritage_gender")


ds['train']['text'][:10]











# Text Generation
generator = pipeline('text-generation', model='gpt2')


# Define a task function
def create_text(prompt):
    # set_seed(42)
    output = generator(prompt, truncation=True, max_length=100, num_return_sequences=3)
    return output


ds['train']['text'][10]


# Pass a prompt into the task function
prompt = ds['train']['text'][10]
create_text(prompt)








# Sentiment Analysis
classifier = pipeline("text-classification", model="SamLowe/roberta-base-go_emotions")


# Define a task function
def classify_sentiment(prompt):
        output = classifier(prompt)
        return output


# Pass a prompt into the task function
classify_sentiment(ds['train']['text'][10])


for i in ds['train']['text'][:10]:
    print(i)
    print(classify_sentiment(i))





# Named Entity Recognition
ner_tagger = pipeline("ner", aggregation_strategy="simple")


# Define a task function
def extract_entities(prompt):
    output = ner_tagger(prompt)
    return pd.DataFrame(output)


# Pass the prompt into the task function
extract_entities(ds['train']['text'][99])





# Question Answering
reader = pipeline("question-answering")


# Define a task function
def answer_question(question, context):
    output = reader(question=question, context=context)
    return pd.DataFrame([output])


# grab the first 50 sentences as "context"

input_sentences = ds['train']['text'][:50]
context = ''.join(input_sentences)


# Pass the prompt into the task function

question = "what's going on?"
answer = answer_question(question, context)


# it returns a dataframe

answer


answer['answer'][0]





# Summarization
summarizer = pipeline("summarization")


# Define a task function
def summarize(text):
    outputs = summarizer(text, max_length=75, clean_up_tokenization_spaces=True)
    return outputs[0]['summary_text']


# Pass the prompt into the task function
summarize(context)


